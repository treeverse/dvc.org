    "lint-css": "stylelint \"src/**/*.css\"",
    "lint-css-fix": "stylelint --fix \"src/**/*.css\"",
    "lint-ts": "tsc --noEmit --skipLibCheck",
    "fix-all": "yarn format-all && yarn lint-fix && yarn lint-css-fix && yarn lint-ts",
    "format-staged": "lint-staged"
